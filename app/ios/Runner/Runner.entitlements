<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: guests scanning the QR open the join flow directly.
	     Requires /.well-known/apple-app-site-association on allpics.app and
	     the Associated Domains capability enabled for the App ID. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:allpics.app</string>
	</array>
</dict>
</plist>
